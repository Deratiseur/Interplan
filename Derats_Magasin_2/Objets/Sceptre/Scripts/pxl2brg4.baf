IF
    See(NearestEnemyOf(Myself))
    HaveSpell(CLERIC_ENTANGLE)  // SPPR105.SPL (Enchevêtrement)
    NumCreatureVsPartyGT([ENEMY],4)
THEN
    RESPONSE #100
        Spell(LastSeenBy(Myself),CLERIC_ENTANGLE)  // SPPR105.SPL (Enchevêtrement)
END

IF
    See(NearestEnemyOf(Myself))
    HaveSpell(CLERIC_SLOW_POISON)  // SPPR212.SPL (Ralentissement du poison)
    StateCheck(LastSeenBy(Myself),STATE_POISONED)
THEN
    RESPONSE #100
        Spell(LastSeenBy(Myself),CLERIC_SLOW_POISON)  // SPPR212.SPL (Ralentissement du poison)
END

IF
    See(NearestEnemyOf(Myself))
    HaveSpell(CLERIC_NEUTRALIZE_POISON)  // SPPR404.SPL (Neutralisation du poison)
    StateCheck(LastSeenBy(Myself),STATE_POISONED)
THEN
    RESPONSE #100
        Spell(LastSeenBy(Myself),CLERIC_NEUTRALIZE_POISON)  // SPPR404.SPL (Neutralisation du poison)
END

IF
    See(Protagonist)
    HPPercentLT(LastSeenBy(Myself),10)
    HaveSpell(CLERIC_HEAL)  // SPPR607.SPL (Guérison)
    !StateCheck(LastSeenBy(Myself),STATE_INVISIBLE)
THEN
    RESPONSE #100
        Spell(LastSeenBy(Myself),CLERIC_HEAL)  // SPPR607.SPL (Guérison)
END

IF
    See(NearestEnemyOf(Myself))
    HaveSpell(CLERIC_IRONSKIN)  // SPPR506.SPL (Peaux de fer)
    CheckStatLT(Myself,1,STONESKINS)
THEN
    RESPONSE #100
        Spell(Myself,CLERIC_IRONSKIN)  // SPPR506.SPL (Peaux de fer)
END

