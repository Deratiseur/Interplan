IF
	AttackedBy([GOODCUTOFF],DEFAULT)
	!Allegiance(Myself,ENEMY)
THEN
	RESPONSE #100
		Enemy()
END

IF
	!ModalState(BATTLESONG)
THEN
	RESPONSE #100
		IncrementGlobal("pxl2goyachant","LOCALS",1)
		BattleSong()
END

IF
	ModalState(BATTLESONG)
	Global("pxl2goyachant","LOCALS",1)
THEN
	RESPONSE #100
		DisplayStringHead(Myself,@301819)
END

IF
	ModalState(BATTLESONG)
	Global("pxl2goyachant","LOCALS",2)
THEN
	RESPONSE #100
			Wait(4)
		DisplayStringHead(Myself,@301829)
END

