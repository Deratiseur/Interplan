IF
	Die()
THEN
    RESPONSE #100	
		ReallyForceSpellDeadRES("pxl2jcvn",Myself)
		Wait(1)
		DestroySelf()
END

IF
	See(NearestEnemyOf(Myself))
    !GlobalTimerNotExpired("pxl2bovi","LOCALS")
THEN
    RESPONSE #100
		PlaySound("COW01")
        ReallyForceSpellRES("pxl2bovi",NearestEnemyOf(Myself))
        SetGlobalTimer("pxl2bovi","LOCALS",6)
END

IF
	GlobalTimerNotExpired("pxl2bovi","LOCALS")
	See(NearestEnemyOf(Myself))
	!Range(NearestEnemyOf(Myself),4)
	Range(NearestEnemyOf(Myself),10)
THEN
	RESPONSE #100
		RunAwayFrom(NearestEnemyOf(Myself),45)
END