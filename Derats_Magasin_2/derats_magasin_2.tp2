  COPY ~Derats_Magasin_2/Sorts/pxl2batp.spl~				~override~	SAY NAME1 @6029	SAY UNIDENTIFIED_DESC @60210
  COPY_EXISTING ~m_dw_sxd.lua~ ~override~
  REPLACE_TEXTUALLY
      ~dwExtraMageSpells\[3\]=~
      ~dwExtraMageSpells[2].pxl2batp={icon='pxl2batc', groundicon='pxl2batb', name=pxl2batpy, desc=pxl2batpx, restrict_alignment={}, restrict_class={}, restrict_kit={[25]=true,}, spec=27, }
dwExtraMageSpells[3]=~
  COPY_EXISTING	~m_dw_sxd.lua~							~override~	REPLACE ~pxl2batpy~ @6029	REPLACE ~pxl2batpx~ @60210
  COPY ~Derats_Magasin_2/Objets/parcho.itm~	~override/pxl2bata.itm~	SAY NAME2 @6029	SAY DESC @60210	LPF cd_scroll INT_VAR unusable1 = BIT1 price = 200  STR_VAR spell = ~pxl2batp~ END
END ELSE BEGIN
  ADD_SPELL 	~Derats_Magasin_2/Sorts/pxl2batp.spl~ 2 2 WIZARD_PX_STAFF_OF_POWER	SPRINT current_spell_res "%DEST_RES%"	SAY NAME1 @6029	SAY UNIDENTIFIED_DESC @60210
  COPY ~Derats_Magasin_2/Objets/parcho.itm~	~override/pxl2bata.itm~	SAY NAME2 @6029	SAY DESC @60210	LPF cd_scroll INT_VAR unusable1 = BIT1 price = 200  STR_VAR spell = EVAL ~%current_spell_res%~ END
END
COPY_EXISTING	~pxagenob.sto~							~override~	ADD_STORE_ITEM ~pxl2bata~ LAST #1 #0 #0 ~IDENTIFIED~ #5
COPY_EXISTING	~pxagenod.sto~							~override~	ADD_STORE_ITEM ~pxl2bata~ BEFORE ~pxl2ppyr~ #1 #0 #0 ~IDENTIFIED~ #3
COPY ~Derats_Magasin_2/Sorts/Objets/pxl2bat1.itm~		~override~	SAY NAME1 @6029	SAY NAME2 @6029
COPY_EXISTING	~pxl2bat1.itm~				~override/pxl2bat2.itm~	WRITE_BYTE 0x12a 6
COPY_EXISTING	~pxl2bat1.itm~				~override/pxl2bat3.itm~	WRITE_BYTE 0x12a 8	WRITE_BYTE 0x86 2	WRITE_BYTE 0x84 2
WRITE_BYTE 0x60 2	WRITE_BYTE 0x10e 2
COPY_EXISTING	~pxl2bat3.itm~				~override/pxl2bat4.itm~	WRITE_BYTE 0x12a 10
COPY_EXISTING	~pxl2bat3.itm~				~override/pxl2bat5.itm~	WRITE_BYTE 0x12a 12	WRITE_BYTE 0x86 3	WRITE_BYTE 0x84 1
WRITE_BYTE 0x60 3	WRITE_BYTE 0x10e 3
COPY_EXISTING	~amcall.vvc~				~override/pxl2bpuv.vvc~	WRITE_ASCII 0x8 ~pxl2bpu1~ #8

//Hexalames
