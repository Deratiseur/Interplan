//Vents protecteurs
ACTION_IF px_interplan_scs THEN BEGIN
  COPY ~Derats_Magasin_2/Sorts/pxl2vent.spl~ ~override~	SAY NAME1 @60425	SAY UNIDENTIFIED_DESC @60426
  SET ZF_inc_level = 1	LPF MULTI_LEVELS END
  READ_LONG 0x64 abilities_off
  READ_SHORT 0x68 num_abilities
  FOR (i = 0; i < num_abilities; i += 1) BEGIN
  	WRITE_BYTE (abilities_off + 0x1b0*i + 0x264) i+7
  END
  COPY_EXISTING ~m_dw_sxd.lua~ ~override~
  REPLACE_TEXTUALLY
      ~dwExtraMageSpells\[5\]=~
      ~dwExtraMageSpells[4].pxl2vent={icon='pxl2venc', groundicon='pxl2venb', name=pxl2venty, desc=pxl2ventx, restrict_alignment={}, restrict_class={}, restrict_kit={[25]=true,}, spec=27, }
dwExtraMageSpells[5]=~
  COPY_EXISTING	~m_dw_sxd.lua~							~override~	REPLACE ~pxl2venty~ @60425	REPLACE ~pxl2ventx~ @60426
  COPY ~Derats_Magasin_2/Objets/parcho.itm~	~override/pxl2vena.itm~	SAY NAME2 @60425	SAY DESC @60426	LPF cd_scroll INT_VAR unusable1 = BIT1 price = 500 STR_VAR spell = ~pxl2vent~ END
END ELSE BEGIN
  ADD_SPELL ~Derats_Magasin_2/Sorts/pxl2vent.spl~ 2 4 WIZARD_PX_PROTECTIVES_WINDS	SPRINT current_spell_res "%DEST_RES%"	SAY NAME1 @60425	SAY UNIDENTIFIED_DESC @60426	WRITE_ASCIIE 0xae "%current_spell_res%" #8
  SET ZF_inc_level = 1	LPF MULTI_LEVELS END
  READ_LONG 0x64 abilities_off
  READ_SHORT 0x68 num_abilities
  FOR (i = 0; i < num_abilities; i += 1) BEGIN
  	WRITE_BYTE (abilities_off + 0x1b0*i + 0x264) i+7
  END
  COPY ~Derats_Magasin_2/Objets/parcho.itm~	~override/pxl2vena.itm~	SAY NAME2 @60425	SAY DESC @60426	LPF cd_scroll INT_VAR unusable1 = BIT1 price = 500 STR_VAR spell = EVAL ~%current_spell_res%~ END
END
COPY_EXISTING	~pxagenob.sto~							~override~	ADD_STORE_ITEM ~pxl2vena~ LAST #1 #0 #0 ~IDENTIFIED~ #5
COPY_EXISTING	~pxagenod.sto~							~override~	ADD_STORE_ITEM ~pxl2vena~ BEFORE ~pxl2ppyr~ #1 #0 #0 ~IDENTIFIED~ #3
COPY_EXISTING	~spstones.vvc~				~override/pxl2ve1v.vvc~	WRITE_ASCII 0x8 ~SPWHIRL~ #8	WRITE_BYTE 0x20 (THIS | 64)	WRITE_BYTE 0x18 (THIS | 2)	WRITE_BYTE 0x1a (THIS | 40)
COPY_EXISTING	~sareveff.eff~				~override/pxl2vnt1.eff~	WRITE_ASCII 0x30 ~pxl2vnt1~ #8

