//Précision
COPY_EXISTING ~statdesc.2da~ ~override~
	COUNT_2DA_ROWS 3 num_rows
	READ_2DA_ENTRY (num_rows - 1) 0 3 last_index
	SET px_prec_i = IS_AN_INT ~last_index~ ? last_index + 1 : num_rows
	BUT_ONLY
	OUTER_SET px_prec_s = RESOLVE_STR_REF(@6021)
	APPEND ~statdesc.2da~ ~%px_prec_i% %px_prec_s% pxl2pred~
	COPY_EXISTING ~statdesc.2da~ ~override~
	PRETTY_PRINT_2DA
	BUT_ONLY
ACTION_IF px_interplan_scs THEN BEGIN
  COPY ~Derats_Magasin_2/Sorts/pxl2prec.spl~				~override~	SAY NAME1 @6021	SAY UNIDENTIFIED_DESC @6022
  READ_LONG 0x64 abilities_off
  READ_SHORT 0x68 num_abilities
  FOR (i = 0; i < num_abilities; i += 1) BEGIN
  	WRITE_BYTE (abilities_off + 0xf0*i + 0x368) %px_prec_i%
  END
  COPY_EXISTING ~m_dw_sxd.lua~ ~override~
  REPLACE_TEXTUALLY
      ~dwExtraMageSpells\[3\]=~
      ~dwExtraMageSpells[2].pxl2prec={icon='pxl2prec', groundicon='pxl2preb', name=pxl2precy, desc=pxl2precx, restrict_alignment={}, restrict_class={}, restrict_kit={[23]=true,}, spec=24, }
dwExtraMageSpells[3]=~
  COPY_EXISTING	~m_dw_sxd.lua~							~override~	REPLACE ~pxl2precy~ @6021	REPLACE ~pxl2precx~ @6022
  COPY ~Derats_Magasin_2/Objets/parcho.itm~	~override/pxl2prea.itm~	SAY NAME2 @6021	SAY DESC @6022	LPF cd_scroll INT_VAR unusable2 = BIT7 price = 200  STR_VAR spell = ~pxl2prec~ END
END ELSE BEGIN
  ADD_SPELL 	~Derats_Magasin_2/Sorts/pxl2prec.spl~ 2 2 WIZARD_PX_ACCURACY	SPRINT current_spell_res "%DEST_RES%"	SAY NAME1 @6021	SAY UNIDENTIFIED_DESC @6022
  LPF ALTER_EFFECT STR_VAR match_resource= pxl2prec resource= EVAL ~%current_spell_res%~ END
  READ_LONG 0x64 abilities_off
  READ_SHORT 0x68 num_abilities
  FOR (i = 0; i < num_abilities; i += 1) BEGIN
  	WRITE_BYTE (abilities_off + 0xf0*i + 0x368) %px_prec_i%
  END
  COPY ~Derats_Magasin_2/Objets/parcho.itm~	~override/pxl2prea.itm~	SAY NAME2 @6021	SAY DESC @6022	LPF cd_scroll INT_VAR unusable2 = BIT7 price = 200  STR_VAR spell = EVAL ~%current_spell_res%~ END
  COPY_EXISTING	~pxl2vlad.cre~							~override~
  WRITE_ASCIIE 0x310 "%current_spell_res%" #8
  WRITE_ASCIIE 0x524 "%current_spell_res%" #8
  WRITE_ASCIIE 0x530 "%current_spell_res%" #8
END
COPY_EXISTING	~pxagenob.sto~							~override~	ADD_STORE_ITEM ~pxl2prea~ LAST #1 #0 #0 ~IDENTIFIED~ #5
COPY_EXISTING	~pxagenod.sto~							~override~	ADD_STORE_ITEM ~pxl2prea~ BEFORE ~pxl2ppyr~ #1 #0 #0 ~IDENTIFIED~ #3
