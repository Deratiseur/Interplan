//////////////////////////////////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////// SORTS DE MAGE VERS CLERC //////////////////////////////////////////
//////////////////////////////////////////////////////////////////////////////////////////////////////////////

BEGIN @38	DESIGNATED 38	LABEL Px_Interplan_Druid
REQUIRE_PREDICATE GAME_IS ~BGT TOB IWDEE BG2EE EET~ @0009
REQUIRE_COMPONENT ~Setup-Derats_magasin_2.tp2~ 33 @39

// Réutiliser les macros et les icônes installées par le composant principal.
INCLUDE ~Derats_Magasin_2/Scripts/Tools/Macros.tph~
COPY_EXISTING ~statdesc.2da~ ~Derats_Magasin_2/TempDir/px_cleric_statdesc.2da~
    SET px_cd_found = 0
    COUNT_2DA_ROWS 3 px_cd_rows
    FOR (px_cd_row = 0; px_cd_row < px_cd_rows; px_cd_row += 1) BEGIN
        READ_2DA_ENTRY px_cd_row 0 3 px_cd_icon
        READ_2DA_ENTRY px_cd_row 2 3 px_cd_bam
        PATCH_IF (~%px_cd_bam%~ STRING_EQUAL_CASE ~pxl2pred~) BEGIN
            SET px_prec_i = px_cd_icon
            SET px_cd_found = (px_cd_found BOR 1)
        END
        PATCH_IF (~%px_cd_bam%~ STRING_EQUAL_CASE ~pxl2armd~) BEGIN
            SET px_armecha_i = px_cd_icon
            SET px_cd_found = (px_cd_found BOR 2)
        END
        PATCH_IF (~%px_cd_bam%~ STRING_EQUAL_CASE ~pxl2dobd~) BEGIN
            SET px_ambidex_i = px_cd_icon
            SET px_cd_found = (px_cd_found BOR 4)
        END
    END
    PATCH_IF (px_cd_found != 7) BEGIN
        PATCH_FAIL ~Interplan : icones de sorts absentes de statdesc.2da ; reinstaller le composant principal.~
    END

INCLUDE ~Derats_Magasin_2/Scripts/Tools/hla_actions.tpa~

// pxl2ex2l : version divine depuis le SPL source
ADD_SPELL ~Derats_Magasin_2/Sorts/pxl2ex2l.spl~ 1 1 CLERIC_PX_FIRE_EXPLOSION
SPRINT current_spell_res "%DEST_RES%"	SAY NAME1 @6011	SAY UNIDENTIFIED_DESC @6012	LPF SPELL_PROJO INT_VAR projectile = ~pxl2expl~ END
LPF ALTER_EFFECT STR_VAR match_resource = pxl2ex2l resource = EVAL ~%current_spell_res%~ END
WRITE_SHORT 0x1c 2	WRITE_LONG 0x1e BIT30

// pxl2ecla : version divine depuis le SPL source
ADD_SPELL ~Derats_Magasin_2/Sorts/pxl2ecla.spl~ 1 1 CLERIC_PX_FIRE_BURST
SPRINT current_spell_res "%DEST_RES%"	SAY NAME1 @6017	SAY UNIDENTIFIED_DESC @6018	LPF SPELL_PROJO INT_VAR projectile = ~pxl2ecla~ END
LPF ALTER_EFFECT STR_VAR match_resource = pxl2ecla resource = EVAL ~%current_spell_res%~ END
WRITE_SHORT 0x1c 2

// pxl2prec : version divine depuis le SPL source
ADD_SPELL ~Derats_Magasin_2/Sorts/pxl2prec.spl~ 1 2 CLERIC_PX_ACCURACY
SPRINT current_spell_res "%DEST_RES%"	SAY NAME1 @6021	SAY UNIDENTIFIED_DESC @6022
LPF ALTER_EFFECT STR_VAR match_resource= pxl2prec resource= EVAL ~%current_spell_res%~ END
READ_LONG 0x64 abilities_off
READ_SHORT 0x68 num_abilities
FOR (i = 0; i < num_abilities; i += 1) BEGIN
	WRITE_BYTE (abilities_off + 0xf0*i + 0x368) %px_prec_i%
END
WRITE_SHORT 0x1c 2	WRITE_LONG 0x1e BIT31

// pxl2puls : version divine depuis le SPL source
ADD_SPELL ~Derats_Magasin_2/Sorts/pxl2puls.spl~ 1 2 CLERIC_PX_FLAME_PULSE
SPRINT current_spell_res "%DEST_RES%"	SAY NAME1 @6025	SAY UNIDENTIFIED_DESC @60269
LPF ALTER_EFFECT STR_VAR match_resource= pxl2puls resource= EVAL ~%current_spell_res%~ END
WRITE_SHORT 0x1c 2	WRITE_LONG 0x1e BIT30

// pxl2grif : version divine depuis le SPL source
ADD_SPELL ~Derats_Magasin_2/Sorts/pxl2grif.spl~ 1 3 CLERIC_PX_DOOM_CLAWS
SPRINT current_spell_res "%DEST_RES%"	SAY NAME1 @6035	SAY UNIDENTIFIED_DESC @6036
LPF ALTER_EFFECT STR_VAR match_resource = pxl2grif resource = EVAL ~%current_spell_res%~ END
WRITE_SHORT 0x1c 2	WRITE_LONG 0x1e BIT31

// pxl2arma : version divine depuis le SPL source
ADD_SPELL ~Derats_Magasin_2/Sorts/pxl2arma.spl~ 1 3 CLERIC_PX_CHARGED_WEAPON
SPRINT current_spell_res "%DEST_RES%"	SAY NAME1 @60311	SAY UNIDENTIFIED_DESC @60312	WRITE_ASCIIE 0xae "%current_spell_res%" #8	WRITE_BYTE 0x192 px_armecha_i
SET ZF_inc_level = 1	SET ZF_inc_duree = 6	LPF MULTI_LEVELS END
LPF ALTER_EFFECT STR_VAR match_resource = pxl2arma resource = EVAL ~%current_spell_res%~ END
WRITE_SHORT 0x1c 2	WRITE_LONG 0x1e BIT31

// pxl2flea : version divine depuis le SPL source
ADD_SPELL ~Derats_Magasin_2/Sorts/pxl2flea.spl~ 1 3 CLERIC_PX_SCOURGE_OF_FIENDS
SPRINT current_spell_res "%DEST_RES%"	SAY NAME1 @60321	SAY UNIDENTIFIED_DESC @60322
LPF ALTER_EFFECT STR_VAR match_resource = pxl2flea resource = EVAL ~%current_spell_res%~ END
WRITE_SHORT 0x1c 2	WRITE_LONG 0x1e BIT31

// pxl2dobb : version divine depuis le SPL source
ADD_SPELL ~Derats_Magasin_2/Sorts/pxl2dobb.spl~ 1 3 CLERIC_PX_AMBIDEXTRY
SPRINT current_spell_res "%DEST_RES%"	SAY NAME1 @60333	SAY UNIDENTIFIED_DESC @60334
LPF ADD_SPELL_EFFECT	INT_VAR opcode = 142 target = 2 parameter2 = px_ambidex_i  duration = 7200 power = 3 resist_dispel = 3 END
LPF ALTER_EFFECT STR_VAR match_resource = pxl2dobb resource = EVAL ~%current_spell_res%~ END
WRITE_SHORT 0x1c 2	WRITE_LONG 0x1e BIT31

// pxl2itg : version divine depuis le SPL source
ADD_SPELL ~Derats_Magasin_2/Sorts/pxl2itg.spl~ 1 3 CLERIC_PX_ENERGY_INTENSIFICATION
SPRINT current_spell_res "%DEST_RES%"	SAY NAME1 @60339	SAY UNIDENTIFIED_DESC @60340
