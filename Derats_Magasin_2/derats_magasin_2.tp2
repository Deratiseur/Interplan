//Refuge d'essence vitale
COPY_EXISTING ~statdesc.2da~ ~override~
	COUNT_2DA_ROWS 3 num_rows
	READ_2DA_ENTRY (num_rows - 1) 0 3 last_index
	SET px_refug_i = IS_AN_INT ~last_index~ ? last_index + 1 : num_rows
	BUT_ONLY
	OUTER_SET px_refug_s = RESOLVE_STR_REF(@60911)
	APPEND ~statdesc.2da~ ~%px_refug_i% %px_refug_s% pxl2rfgd~
	COPY_EXISTING ~statdesc.2da~ ~override~
	PRETTY_PRINT_2DA
	BUT_ONLY
