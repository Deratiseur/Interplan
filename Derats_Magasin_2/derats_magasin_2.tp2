//Vol de sortilège
ACTION_IF px_interplan_scs THEN BEGIN
  COPY ~Derats_Magasin_2/Sorts/pxl2vlso.spl~ ~override~	SAY NAME1 @60325	SAY UNIDENTIFIED_DESC @60326
  COPY_EXISTING ~m_dw_sxd.lua~ ~override~
  REPLACE_TEXTUALLY
      ~dwExtraMageSpells\[4\]=~
      ~dwExtraMageSpells[3].pxl2vlso={icon='pxl2vlsc', groundicon='pxl2vlsb', name=pxl2vlsoy, desc=pxl2vlsox, restrict_alignment={}, restrict_class={}, restrict_kit={[27]=true,}, spec=25, }
dwExtraMageSpells[4]=~
  COPY_EXISTING	~m_dw_sxd.lua~							~override~	REPLACE ~pxl2vlsoy~ @60325	REPLACE ~pxl2vlsox~ @60326
  COPY ~Derats_Magasin_2/Objets/parcho.itm~	~override/pxl2vlsa.itm~	SAY NAME2 @60325	SAY DESC @60326	LPF cd_scroll INT_VAR unusable1 = BIT3 target_hdr = 1 range = 0 price = 300 STR_VAR spell = ~pxl2vlso~ END
END ELSE BEGIN
  ADD_SPELL ~Derats_Magasin_2/Sorts/pxl2vlso.spl~ 2 3 WIZARD_PX_SPELL_STEAL	SPRINT current_spell_res "%DEST_RES%"	SAY NAME1 @60325	SAY UNIDENTIFIED_DESC @60326
  COPY ~Derats_Magasin_2/Objets/parcho.itm~	~override/pxl2vlsa.itm~	SAY NAME2 @60325	SAY DESC @60326	LPF cd_scroll INT_VAR unusable1 = BIT3 target_hdr = 1 range = 0 price = 300 STR_VAR spell = EVAL ~%current_spell_res%~ END
END
COPY_EXISTING	~pxagenob.sto~							~override~	ADD_STORE_ITEM ~pxl2vlsa~ LAST #1 #0 #0 ~IDENTIFIED~ #5
COPY_EXISTING	~pxagenod.sto~							~override~	ADD_STORE_ITEM ~pxl2vlsa~ BEFORE ~pxl2ppyr~ #1 #0 #0 ~IDENTIFIED~ #3
COPY_EXISTING	~sareveff.eff~				~override/pxl2vls1.eff~	WRITE_ASCII 0x30 ~pxl2vls1~ #8
COPY_EXISTING	~amcall.vvc~				~override/pxl2vlrv.vvc~	WRITE_ASCII 0x8 ~pxl2volr~ #8	WRITE_BYTE 0x4c 10

//Un pas dans l'ombre
COPY_EXISTING ~statdesc.2da~ ~override~
	COUNT_2DA_ROWS 3 num_rows
	READ_2DA_ENTRY (num_rows - 1) 0 3 last_index
	SET px_ombre_i = IS_AN_INT ~last_index~ ? last_index + 1 : num_rows
	BUT_ONLY
	OUTER_SET px_ombre_s = RESOLVE_STR_REF(@60327)
	APPEND ~statdesc.2da~ ~%px_ombre_i% %px_ombre_s% pxl2pobd~
	COPY_EXISTING ~statdesc.2da~ ~override~
	PRETTY_PRINT_2DA
	BUT_ONLY
ACTION_IF px_interplan_scs THEN BEGIN
  COPY ~Derats_Magasin_2/Sorts/pxl2pob.spl~ ~override~	SAY NAME1 @60327	SAY UNIDENTIFIED_DESC @60328	WRITE_BYTE 0x2e2 px_ombre_i
  SET ZF_inc_level = 1	SET ZF_inc_duree = 6	LPF MULTI_LEVELS END
  READ_LONG 0x64 abilities_off
  READ_SHORT 0x68 num_abilities
  FOR (i = 0; i < num_abilities; i += 1) BEGIN
  	WRITE_BYTE (abilities_off + 0x2D0*i + 0x374) i+5
  END
  COPY_EXISTING ~m_dw_sxd.lua~ ~override~
  REPLACE_TEXTUALLY
      ~dwExtraMageSpells\[4\]=~
      ~dwExtraMageSpells[3].pxl2pob={icon='pxl2pobc', groundicon='pxl2pobb', name=pxl2poby, desc=pxl2pobx, restrict_alignment={}, restrict_class={}, restrict_kit={[28]=true,}, spec=26, }
dwExtraMageSpells[4]=~
  COPY_EXISTING	~m_dw_sxd.lua~							~override~	REPLACE ~pxl2poby~ @60327	REPLACE ~pxl2pobx~ @60328
  COPY ~Derats_Magasin_2/Objets/parcho.itm~	~override/pxl2poba.itm~	SAY NAME2 @60327	SAY DESC @60328	LPF cd_scroll INT_VAR unusable1 = BIT4 price = 300 STR_VAR spell = ~pxl2pob~ END
  COPY ~Derats_Magasin_2/Objets/sorts/pxl2pmb3.spl~		~override~	SAY NAME1 @60327	WRITE_ASCII 0x34e "pxl2pob" #8
END ELSE BEGIN
  ADD_SPELL ~Derats_Magasin_2/Sorts/pxl2pob.spl~ 2 3 WIZARD_PX_SHADOW_WALK	SPRINT current_spell_res "%DEST_RES%"	SAY NAME1 @60327	SAY UNIDENTIFIED_DESC @60328	WRITE_ASCIIE 0xae "%current_spell_res%" #8	WRITE_BYTE 0x2e2 px_ombre_i
  SET ZF_inc_level = 1	SET ZF_inc_duree = 6	LPF MULTI_LEVELS END
  READ_LONG 0x64 abilities_off
  READ_SHORT 0x68 num_abilities
  FOR (i = 0; i < num_abilities; i += 1) BEGIN
  	WRITE_BYTE (abilities_off + 0x2D0*i + 0x374) i+5
  END
  COPY ~Derats_Magasin_2/Objets/parcho.itm~	~override/pxl2poba.itm~	SAY NAME2 @60327	SAY DESC @60328	LPF cd_scroll INT_VAR unusable1 = BIT4 price = 300 STR_VAR spell = EVAL ~%current_spell_res%~ END
  COPY_EXISTING	~pxl2drag.2da~							~override~	REPLACE_TEXTUALLY ~PXL2POB~ ~%current_spell_res%~
  COPY ~Derats_Magasin_2/Objets/sorts/pxl2pmb3.spl~		~override~	SAY NAME1 @60327	WRITE_ASCIIE 0x34e "%current_spell_res%" #8
  ACTION_IF GAME_IS ~TOB BGT BG2EE EET~ THEN BEGIN
  COPY_EXISTING	~pxoagen.cre~							~override~
  WRITE_ASCIIE 0x34c "%current_spell_res%" #8
  WRITE_ASCIIE 0x690 "%current_spell_res%" #8
  WRITE_ASCIIE 0x69c "%current_spell_res%" #8
  END
END
COPY_EXISTING	~pxagenob.sto~							~override~	ADD_STORE_ITEM ~pxl2poba~ LAST #1 #0 #0 ~IDENTIFIED~ #5
COPY_EXISTING	~pxagenod.sto~							~override~	ADD_STORE_ITEM ~pxl2poba~ BEFORE ~pxl2ppyr~ #1 #0 #0 ~IDENTIFIED~ #3
OUTER_FOR ( i=2 ; i<20 ; i +=1) BEGIN
COPY_EXISTING	~pxoinv1.spl~			~override/pxoinv%i%.spl~	WRITE_BYTE 0xa8 12+6*(i -2)
END
COPY_EXISTING	~amcall.vvc~				~override/pxl2pobv.vvc~	WRITE_ASCII 0x8 ~pxganima~ #8

