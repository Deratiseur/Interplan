//Poing rageur de Keleg-Ze
ACTION_IF px_interplan_scs THEN BEGIN
  COPY ~Derats_Magasin_2/Sorts/pxl2poig.spl~ ~override~	SAY NAME1 @60417	SAY UNIDENTIFIED_DESC @60418
  COPY_EXISTING ~m_dw_sxd.lua~ ~override~
  REPLACE_TEXTUALLY
      ~dwExtraMageSpells\[5\]=~
      ~dwExtraMageSpells[4].pxl2poig={icon='pxl2poic', groundicon='pxl2poib', name=pxl2poigy, desc=pxl2poigx, restrict_alignment={}, restrict_class={}, restrict_kit={[25]=true,}, spec=27, }
dwExtraMageSpells[5]=~
  COPY_EXISTING	~m_dw_sxd.lua~							~override~	REPLACE ~pxl2poigy~ @60417	REPLACE ~pxl2poigx~ @60418
  COPY ~Derats_Magasin_2/Objets/parcho.itm~	~override/pxl2poia.itm~	SAY NAME2 @60417	SAY DESC @60418	LPF cd_scroll INT_VAR unusable1 = BIT1  price = 500 STR_VAR spell = ~pxl2poig~ END
END ELSE BEGIN
  ADD_SPELL ~Derats_Magasin_2/Sorts/pxl2poig.spl~ 2 4 WIZARD_PX_KELEGZES_FURIOUS_FIST	SPRINT current_spell_res "%DEST_RES%"	SAY NAME1 @60417	SAY UNIDENTIFIED_DESC @60418
  COPY ~Derats_Magasin_2/Objets/parcho.itm~	~override/pxl2poia.itm~	SAY NAME2 @60417	SAY DESC @60418	LPF cd_scroll INT_VAR unusable1 = BIT1  price = 500 STR_VAR spell = EVAL ~%current_spell_res%~ END
  COPY_EXISTING	~pxl2shel.cre~							~override~
  WRITE_ASCIIE 0x358 "%current_spell_res%" #8
  WRITE_ASCIIE 0x59c "%current_spell_res%" #8
  WRITE_ASCIIE 0x5a8 "%current_spell_res%" #8
END
COPY_EXISTING	~pxagenob.sto~							~override~	ADD_STORE_ITEM ~pxl2poia~ LAST #1 #0 #0 ~IDENTIFIED~ #5
COPY_EXISTING	~pxagenod.sto~							~override~	ADD_STORE_ITEM ~pxl2poia~ BEFORE ~pxl2ppyr~ #1 #0 #0 ~IDENTIFIED~ #3
COPY ~Derats_Magasin_2/Sorts/Objets/pxl2pg7.itm~		~override~	SAY NAME2 @604181
OUTER_FOR ( i=8 ; i<21 ; i +=1) BEGIN //Pour chaque objet à créer nommé de 8 à 20
	COPY_EXISTING	~pxl2pg7.itm~		~override/pxl2pg%i%.itm~	WRITE_BYTE 0x1b6 ~i~ //Nombre de dés de dégâts
END

