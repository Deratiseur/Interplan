////////////////////// SORTS DE  NIVEAU 3 //////////////////////


//Vision instinctive d'Hachitoza
COPY_EXISTING ~statdesc.2da~ ~override~
	COUNT_2DA_ROWS 3 num_rows
	READ_2DA_ENTRY (num_rows - 1) 0 3 last_index
	SET px_visioa_i = IS_AN_INT ~last_index~ ? last_index + 1 : num_rows
	BUT_ONLY
ACTION_IF px_interplan_scs THEN BEGIN
  	OUTER_SET px_visioa_s = RESOLVE_STR_REF(@60311)
  COPY ~Derats_Magasin_2/Sorts/pxl2visi.spl~ ~override~	SAY NAME1 @6031	SAY UNIDENTIFIED_DESC @6032	WRITE_BYTE 0x312 px_visioa_i
  SET ZF_inc_level = 2	SET ZF_inc_duree = 6	LPF MULTI_LEVELS END
  COPY_EXISTING ~m_dw_sxd.lua~ ~override~
  REPLACE_TEXTUALLY
      ~dwExtraMageSpells\[4\]=~
      ~dwExtraMageSpells[3].pxl2visi={icon='pxl2visc', groundicon='pxl2visb', name=pxl2visiy, desc=pxl2visix, restrict_alignment={}, restrict_class={}, restrict_kit={[23]=true,}, spec=24, }
dwExtraMageSpells[4]=~
  COPY_EXISTING	~m_dw_sxd.lua~							~override~	REPLACE ~pxl2visiy~ @6031	REPLACE ~pxl2visix~ @6032
  COPY ~Derats_Magasin_2/Objets/parcho.itm~	~override/pxl2visa.itm~	SAY NAME2 @6031	SAY DESC @6032	LPF cd_scroll INT_VAR unusable2 = BIT7 price = 300 STR_VAR spell = ~pxl2visi~ END
END ELSE BEGIN
  	OUTER_SET px_visioa_s = RESOLVE_STR_REF(@6031)
  ADD_SPELL ~Derats_Magasin_2/Sorts/pxl2visi.spl~ 2 3 WIZARD_PX_HACHITOZAS_INSTINCTIVE_VISION	SPRINT current_spell_res "%DEST_RES%"	SAY NAME1 @6031	SAY UNIDENTIFIED_DESC @6032	WRITE_ASCIIE 0xae "%current_spell_res%" #8	WRITE_BYTE 0x312 px_visioa_i
  SET ZF_inc_level = 2	SET ZF_inc_duree = 6	LPF MULTI_LEVELS END
  COPY ~Derats_Magasin_2/Objets/parcho.itm~	~override/pxl2visa.itm~	SAY NAME2 @6031	SAY DESC @6032	LPF cd_scroll INT_VAR unusable2 = BIT7 price = 300 STR_VAR spell = EVAL ~%current_spell_res%~ END
  COPY ~Derats_Magasin_2/Sorts/pxl2achi.spl~				~override~	WRITE_ASCIIE 0xde "%current_spell_res%" #8	WRITE_BYTE 0x312 px_visioa_i
END
COPY_EXISTING	~pxagenob.sto~							~override~	ADD_STORE_ITEM ~pxl2visa~ LAST #1 #0 #0 ~IDENTIFIED~ #5
