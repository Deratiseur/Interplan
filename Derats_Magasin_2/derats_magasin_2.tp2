  ADD_SPELL ~Derats_Magasin_2/Sorts/pxl2itg.spl~ 2 3 WIZARD_PX_ENERGY_INTENSIFICATION	SPRINT current_spell_res "%DEST_RES%"	SAY NAME1 @60339	SAY UNIDENTIFIED_DESC @60340
  COPY ~Derats_Magasin_2/Objets/parcho.itm~	~override/pxl2itga.itm~	SAY NAME2 @60339	SAY DESC @60340	LPF cd_scroll INT_VAR unusable2 = BIT6 price = 300 STR_VAR spell = EVAL ~%current_spell_res%~ END
