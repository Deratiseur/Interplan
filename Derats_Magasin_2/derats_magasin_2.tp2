//////////////////////////////////////////////////////////////////////////////////////////////////////////////
/////////////////////////////////////// PARCHEMINS ET POTIONS INFINIS ////////////////////////////////////////
//////////////////////////////////////////////////////////////////////////////////////////////////////////////

BEGIN @50	DESIGNATED 50	LABEL Px_Interplan_Potions
REQUIRE_PREDICATE GAME_IS ~IWDEE BG2EE EET~ @9003
REQUIRE_COMPONENT ~Setup-Derats_magasin_2.tp2~ 33 @39
ACTION_IF GAME_IS ~BG2EE EET~ THEN BEGIN
COPY_EXISTING	~pxagen2c.sto~			~override~
REMOVE_STORE_ITEM	~pxl2infi~
GET_OFFSET_ARRAY items_array STO_V10_ITEMS_SOLD
PHP_EACH items_array AS _ => offset BEGIN
WRITE_LONG (offset + 0x18) 1
END
ADD_STORE_ITEM ~pxl2infi~ LAST #0 #0 #0 ~IDENTIFIED~ #1
END
ACTION_IF GAME_IS ~IWDEE~ THEN BEGIN
COPY_EXISTING	~pxagenoc.sto~			~override~
REMOVE_STORE_ITEM	~pxl2infi~
GET_OFFSET_ARRAY items_array STO_V10_ITEMS_SOLD
PHP_EACH items_array AS _ => offset BEGIN
WRITE_LONG (offset + 0x18) 1
END
ADD_STORE_ITEM ~pxl2infi~ LAST #0 #0 #0 ~IDENTIFIED~ #1
END

BEGIN @69	DESIGNATED 69	LABEL Px_Interplan_Parchemins
REQUIRE_PREDICATE GAME_IS ~IWDEE BG2EE EET~ @9003
REQUIRE_COMPONENT ~Setup-Derats_magasin_2.tp2~ 33 @39
ACTION_IF GAME_IS ~BG2EE EET~ THEN BEGIN
COPY_EXISTING	~pxagen2b.sto~			~override~
GET_OFFSET_ARRAY items_array STO_V10_ITEMS_SOLD
PHP_EACH items_array AS _ => offset BEGIN
WRITE_LONG (offset + 0x18) 1
END
END
ACTION_IF GAME_IS ~IWDEE~ THEN BEGIN
COPY_EXISTING	~pxagenob.sto~			~override~
GET_OFFSET_ARRAY items_array STO_V10_ITEMS_SOLD
PHP_EACH items_array AS _ => offset BEGIN
WRITE_LONG (offset + 0x18) 1
END
END

