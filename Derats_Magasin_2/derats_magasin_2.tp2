BEGIN @33	DESIGNATED 33	LABEL Px_Interplan_Main
REQUIRE_PREDICATE GAME_IS ~BGT TOB IWDEE BG2EE EET~ @9003

INCLUDE ~Derats_Magasin_2/Scripts/Tools/Macros.tph~
INCLUDE ~Derats_Magasin_2/Scripts/Tools/gw_functions.tpa~
LAM ~GW_ADJUST_COL_TOOLTIP~
LAM ~GW_READ_COL_TOOLTIP~
COMPILE ~Derats_Magasin_2/Scripts~
SILENT
COMPILE ~Derats_Magasin_2/Objets/Scripts~
VERBOSE
COMPILE ~Derats_Magasin_2/Sorts/Scripts~

////////// CARTE, MARCHAND ET EXTRAS POUR BG2 //////////
ACTION_IF GAME_IS ~BG2EE EET~ THEN BEGIN
	COPY_EXISTING	~AR0700.are~					~override~
	PATCH_IF SOURCE_SIZE > 0x28f BEGIN
		LPF fj_are_structure
		INT_VAR
		fj_type			= 2    //travel
		fj_box_left		= 3770
		fj_box_top		= 278
		fj_box_right	= 3833
		fj_box_bottom	= 377
		fj_cursor_idx	= 30   //door
		fj_loc_x		= 3801
		fj_loc_y		= 328
		fj_vertex_0		= 3770 + (346 << 16)
		fj_vertex_1		= 3833 + (377 << 16)
		fj_vertex_2		= 3833 + (307 << 16)
		fj_vertex_3		= 3777 + (278 << 16)
		STR_VAR
		fj_structure_type	= region
		fj_name				= pxoageno // Nom de la boutique
		fj_destination_area	= pxoage // Code de la carte
		fj_destination_name	= enpxoa
		END
		LPF fj_are_structure
		INT_VAR
		fj_loc_x			= 3715
		fj_loc_y			= 407
		fj_orientation		= 2   //SW
		STR_VAR
		fj_structure_type	= entrance
		fj_name				= sopxoa
		END
		ADD_MAP_NOTE #3739 #362 ~Gray~ @33
	END
	BUT_ONLY
	COPY ~Derats_Magasin_2/BG2/Copy~				~override~
		 ~Derats_Magasin_2/BG2/Boring~				~override~ //Pour UN personnage du sceptre. Est-ce bien utile ?
		 ~Derats_Magasin_2/BG2/Lizard~				~override~
		 ~Derats_Magasin_2/BG2/Extras/Copy~			~override~
	COPY ~Derats_Magasin_2/BG2/pxoagen.cre~			~override~	SAY NAME1 @34	SAY NAME2 @34
	COMPILE ~Derats_Magasin_2/BG2/Dialogs~
	COMPILE ~Derats_Magasin_2/BG2/Scripts~
	ADD_JOURNAL @61 @62 @63 @64 @65 USING ~Derats_Magasin_2/Languages/%LANGUAGE%/setup.tra~
	EXTEND_TOP ~AR0334.BCS~   ~Derats_Magasin_2/BG2/Scripts/Append/pxo0334.baf~
	EXTEND_TOP ~AR5013.BCS~   ~Derats_Magasin_2/BG2/Scripts/Append/pxo5013.baf~
	//EXTEND_TOP ~AR0700.BCS~   ~Derats_Magasin_2/BG2/Scripts/Append/pxo0700.baf~ //Perle de gelée, je n'y arrive pas
	COPY ~Derats_Magasin_2/BG2/pxagenoa.sto~	~override/pxagen2a.sto~	SAY 0xc @45
	ADD_STORE_ITEM ~pxl2qu5~  AFTER ~pxl2hera~ #1 #0 #0 ~IDENTIFIED~ #1 //Chandelle du monstre
	ADD_STORE_ITEM ~pxl2cata~ AFTER ~pxl2tome~ #0 #0 #0 ~IDENTIFIED~ #1 //Catalyseur du marteau Johrünbrumd
	COPY ~Derats_Magasin_2/BG2/pxagenoc.sto~	~override/pxagen2c.sto~	SAY 0xc @47
	ADD_STORE_ITEM ~pxl2ampl~ FIRST #0 #0 #0 ~IDENTIFIED~ #100 //Amplificateur
	COPY ~Derats_Magasin_2/Objets/pxl2gemp.itm~		~override~	SAY NAME2 @48	SAY DESC @49
	COPY_EXISTING	~YSSOLD14.cre~					~override~	ADD_CRE_ITEM ~pxl2gemp~ #0 #0 #0 ~NONE~ ~INV~
																ADD_CRE_ITEM ~pxl2ampl~ #2 #0 #0 ~IDENTIFIED~ ~INV~
																ADD_CRE_ITEM ~pxl2amp2~ #0 #0 #0 ~IDENTIFIED~ ~INV~
	COPY ~Derats_Magasin_2/BG2/Extras/pxl2ckri.cre~	~override~	SAY NAME1 @43	SAY NAME2 @43
	COPY ~Derats_Magasin_2/BG2/Extras/pxl2ckri.sto~	~override~	SAY 0xc @44
END

////////// QUÊTE POUR BG2EE //////////
ACTION_IF GAME_IS ~BG2EE EET~ THEN BEGIN
	COPY ~Derats_Magasin_2/BG2/Quest/Copy~			~override~
	COPY ~Derats_Magasin_2/BG2/Quest/pxl2elf1.spl~	~override~	SAY NAME1 @51	SAY UNIDENTIFIED_DESC @52
	COPY ~Derats_Magasin_2/Objets/parcho.itm~	~override/pxl2elf1.itm~	SAY NAME2 @51	SAY DESC @52	LPF cd_scroll INT_VAR unusable2 = BIT6 target_hdr = 1 price = 10000 STR_VAR spell = pxl2elf1 END
	COPY ~Derats_Magasin_2/BG2/Quest/pxl2elf2.itm~	~override~	SAY NAME2 @53	SAY DESC @54
	COPY ~Derats_Magasin_2/BG2/Quest/pxl2qpow.itm~	~override~	SAY NAME2 @55	SAY DESC @56
	COPY_EXISTING	~pxl2elf1.spl~		~override/pxl2elf3.spl~	
	READ_LONG 0x6a effects_off
	READ_SHORT 0x90 num_effects
	FOR (i = 0; i < num_effects; i += 1) BEGIN	WRITE_BYTE  (effects_off + 0x30*i + 0x024) 0 END
	COPY_EXISTING	~pxl2elf1.spl~		~override/pxl2elf4.spl~	WRITE_ASCII 0x3a ~pxl2pelb~ #8	WRITE_ASCII 0x76 ~pxl2pelb~ #8
END

////////// MARCHAND POUR LES FOSSES NOIRES II //////////
ACTION_IF GAME_IS ~BG2EE EET~ THEN BEGIN
	COPY ~Derats_Magasin_2/BG2/pxagenoa.sto~		~override~	SAY 0xc @45
	COPY ~Derats_Magasin_2/BG2/pxagenob.sto~		~override~	SAY 0xc @46
	COPY ~Derats_Magasin_2/BG2/pxagenoc.sto~		~override~	SAY 0xc @47
	EXTEND_TOP ~OHBHUB.BCS~   ~Derats_Magasin_2/BG2/Scripts/Append/pxo8100.baf~
END

////////// MARCHAND POUR LES PSTEE //////////
ACTION_IF GAME_IS ~PSTEE~ THEN BEGIN
	COPY ~Derats_Magasin_2/BG2/pxagenoa.sto~		~override~	SAY 0xc @45
	COPY ~Derats_Magasin_2/BG2/pxagenob.sto~		~override~	SAY 0xc @46
	COPY ~Derats_Magasin_2/BG2/pxagenoc.sto~		~override~	SAY 0xc @47
	EXTEND_TOP ~AR0504.BCS~   ~Derats_Magasin_2/BG2/Scripts/Append/pxo0504.baf~
	COPY ~Derats_Magasin_2/BG2/pxoagen.cre~			~override~	SAY NAME1 @34	SAY NAME2 @34
	WRITE_LONG 0x28 (IDS_OF_SYMBOL (~animate~ ~Merchant~))
END	

////////// MARCHAND POUR IWDEE //////////
ACTION_IF GAME_IS ~IWDEE~ THEN BEGIN
	EXTEND_TOP ~AR3001.BCS~   ~Derats_Magasin_2/IWD/pxl2iwd.baf~
	EXTEND_TOP ~AR7005.BCS~   ~Derats_Magasin_2/IWD/pxo7005.baf~
	EXTEND_TOP ~AR3000.BCS~   ~Derats_Magasin_2/BG2/Scripts/Append/pxo5013.baf~
	COPY ~Derats_Magasin_2/IWD/copy~				~override~
	COPY ~Derats_Magasin_2/IWD/pxl2iwd.cre~			~override~	SAY NAME1 @40	SAY NAME2 @40
	COPY ~Derats_Magasin_2/IWD/pxl2iwd.itm~			~override~	SAY NAME2 @41	SAY DESC @42
	COMPILE ~Derats_Magasin_2/IWD/pxl2iwd.d~
	COMPILE ~Derats_Magasin_2/IWD/pxl2iwds.baf~
	COPY ~Derats_Magasin_2/BG2/pxagenoa.sto~		~override~	SAY 0xc @45
	REMOVE_STORE_ITEM	~pxl2gsor~ //Ceinture Gardesorts (9/10 des parchemins ont une référence changée ou n'existent pas)
	REMOVE_STORE_ITEM	~pxl2puri~ //Purificateur nain (icône venue de IWDEE)
	ADD_STORE_ITEM ~pxl2qu5~  AFTER ~pxl2corn~ #2 #0 #0 ~IDENTIFIED~ #1 //Chandelle du monstre version IWD
	COPY ~Derats_Magasin_2/BG2/pxagenob.sto~		~override~	SAY 0xc @46
	COPY ~Derats_Magasin_2/BG2/pxagenoc.sto~		~override~	SAY 0xc @47
	//Armes pour les personnages du Sceptre   --- supprimer le sceptre du magasin IWDEE ?
	COPY ~Derats_Magasin_2/IWD/Weapons/ax1h17.itm~	~override~	SAY NAME2 @9901
	COPY ~Derats_Magasin_2/IWD/Weapons/dagg11.itm~	~override~	SAY NAME2 @9902
	COPY ~Derats_Magasin_2/IWD/Weapons/dart08.itm~	~override~	SAY NAME2 @9903
	COPY ~Derats_Magasin_2/IWD/Weapons/staf09.itm~	~override~	SAY NAME2 @9904
	LAF ~GW_ADD_ITEM_TOOLTIPS~ STR_VAR GW_objet = ~staf09~ GW_tooltips = ~@9904 22614~ END
	COPY ~Derats_Magasin_2/IWD/Weapons/staf11.itm~	~override~	SAY NAME2 @9905
	LAF ~GW_ADD_ITEM_TOOLTIPS~ STR_VAR GW_objet = ~staf11~ GW_tooltips = ~@9905	@99051 26304~ END
	COPY ~Derats_Magasin_2/IWD/Weapons/staf15.itm~	~override~	SAY NAME2 @9906
	LAF ~GW_ADD_ITEM_TOOLTIPS~ STR_VAR GW_objet = ~staf15~ GW_tooltips = ~@9906 12047 24839~ END
	COPY ~Derats_Magasin_2/IWD/Weapons/staf16.itm~	~override~	SAY NAME2 @9907
	LAF ~GW_ADD_ITEM_TOOLTIPS~ STR_VAR GW_objet = ~staf16~ GW_tooltips = ~@9907 32393 15180~ END
	COPY ~Derats_Magasin_2/IWD/Weapons/staf17.itm~	~override~	SAY NAME2 @9908
	LAF ~GW_ADD_ITEM_TOOLTIPS~ STR_VAR GW_objet = ~staf17~ GW_tooltips = ~@9908 15211 25880~ END
	COPY ~Derats_Magasin_2/IWD/Weapons/sw1h22.itm~	~override~	SAY NAME2 @9909
	COPY ~Derats_Magasin_2/IWD/Weapons/sw1h72.itm~	~override~	SAY NAME2 @99010
	COPY ~Derats_Magasin_2/IWD/Weapons/sw1h73.itm~	~override~	SAY NAME2 @99011
	COPY ~Derats_Magasin_2/IWD/Weapons/sw1h75.itm~	~override~	SAY NAME2 @99012
	COPY ~Derats_Magasin_2/IWD/Weapons/sw2h20.itm~	~override~	SAY NAME2 @99013
END

