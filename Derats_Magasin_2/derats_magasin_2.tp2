  ADD_SPELL ~Derats_Magasin_2/Sorts/pxl2hexa.spl~ 2 2 WIZARD_PX_HEXABLADES	SPRINT current_spell_res "%DEST_RES%"	SAY NAME1 @60211	SAY UNIDENTIFIED_DESC @60212
  COPY ~Derats_Magasin_2/Objets/parcho.itm~	~override/pxl2hexa.itm~	SAY NAME2 @60211	SAY DESC @60212	LPF cd_scroll INT_VAR unusable1 = BIT1 target_hdr = 1  price = 200 STR_VAR spell = EVAL ~%current_spell_res%~ END
