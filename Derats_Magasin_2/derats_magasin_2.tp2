  COPY ~Derats_Magasin_2/Objets/parcho.itm~	~override/pxl2rsaa.itm~	SAY NAME2 @60223	SAY DESC @60224	LPF cd_scroll INT_VAR unusable1 = BIT3 target_hdr = 1 price = 200 STR_VAR spell = EVAL ~%current_spell_res%~ END
