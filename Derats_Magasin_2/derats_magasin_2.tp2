SPRINT current_spell_res "%DEST_RES%"	SAY NAME1 @60425	SAY UNIDENTIFIED_DESC @60426	WRITE_ASCIIE 0xae "%current_spell_res%" #8
SET ZF_inc_level = 1	LPF MULTI_LEVELS END
READ_LONG 0x64 abilities_off
READ_SHORT 0x68 num_abilities
FOR (i = 0; i < num_abilities; i += 1) BEGIN
