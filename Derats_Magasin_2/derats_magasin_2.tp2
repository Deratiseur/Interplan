//Bras de foudre
ACTION_IF px_interplan_scs THEN BEGIN
  COPY_EXISTING ~statdesc.2da~ ~override~
  	COUNT_2DA_ROWS 3 num_rows
  	READ_2DA_ENTRY (num_rows - 1) 0 3 last_index
  	SET px_brel_i = IS_AN_INT ~last_index~ ? last_index + 1 : num_rows
  	BUT_ONLY
  	OUTER_SET px_brel_s = RESOLVE_STR_REF(@60811)
  	APPEND ~statdesc.2da~ ~%px_brel_i% %px_brel_s% pxl2brld~
  	COPY_EXISTING ~statdesc.2da~ ~override~
  	PRETTY_PRINT_2DA
  	BUT_ONLY
  COPY ~Derats_Magasin_2/Sorts/pxl2brel.spl~ ~override~	SAY NAME1 @60811	SAY UNIDENTIFIED_DESC @60812	WRITE_BYTE 0x102 px_brel_i
  COPY_EXISTING ~m_dw_sxd.lua~ ~override~
  REPLACE_TEXTUALLY
      ~dwExtraMageSpells\[9\]=~
      ~dwExtraMageSpells[8].pxl2brel={icon='pxl2brlc', groundicon='pxl2brlb', name=pxl2brely, desc=pxl2brelx, restrict_alignment={}, restrict_class={}, restrict_kit={[25]=true,}, spec=27, }
dwExtraMageSpells[9]=~
  COPY_EXISTING	~m_dw_sxd.lua~							~override~	REPLACE ~pxl2brely~ @60811	REPLACE ~pxl2brelx~ @60812
  COPY ~Derats_Magasin_2/Objets/parcho.itm~	~override/pxl2brla.itm~	SAY NAME2 @60811	SAY DESC @60812	LPF cd_scroll INT_VAR unusable1 = BIT1 price = 5000 STR_VAR spell = ~pxl2brel~ END
  COPY ~Derats_Magasin_2/Sorts/pxl2brl2.spl~				~override~	WRITE_ASCII 0x13e "pxl2brel" #8
END ELSE BEGIN
  ADD_SPELL ~Derats_Magasin_2/Sorts/pxl2brel.spl~ 2 8 WIZARD_PX_ELECTRIC_ARM	SPRINT current_spell_res "%DEST_RES%"	SAY NAME1 @60811	SAY UNIDENTIFIED_DESC @60812	WRITE_ASCIIE 0xae "%current_spell_res%" #8
  COPY ~Derats_Magasin_2/Objets/parcho.itm~	~override/pxl2brla.itm~	SAY NAME2 @60811	SAY DESC @60812	LPF cd_scroll INT_VAR unusable1 = BIT1 price = 5000 STR_VAR spell = EVAL ~%current_spell_res%~ END
  COPY ~Derats_Magasin_2/Sorts/pxl2brl2.spl~				~override~	WRITE_ASCIIE 0x13e "%current_spell_res%" #8
END
