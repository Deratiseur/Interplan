COPY_EXISTING	~pxagenob.sto~							~override~	ADD_STORE_ITEM ~pxl2itga~ LAST #1 #0 #0 ~IDENTIFIED~ #5
COPY_EXISTING	~pxagenod.sto~							~override~	ADD_STORE_ITEM ~pxl2itga~ BEFORE ~pxl2ppyr~ #1 #0 #0 ~IDENTIFIED~ #3
COPY ~Derats_Magasin_2/Sorts/pxl2itg.spl~ 				~override~	SAY NAME1 @60339	SAY UNIDENTIFIED_DESC @60340
COPY_EXISTING ~statdesc.2da~ ~override~
	COUNT_2DA_ROWS 3 num_rows
	READ_2DA_ENTRY (num_rows - 1) 0 3 last_index
	SET px_itg_f = IS_AN_INT ~last_index~ ? last_index + 1 : num_rows
	SET px_itg_o = px_itg_f + 1
	SET px_itg_e = px_itg_f + 2
	SET px_itg_a = px_itg_f + 3
	SET px_itg_m = px_itg_f + 4
	BUT_ONLY
	OUTER_SET px_itg_sf = RESOLVE_STR_REF(@603401)
	OUTER_SET px_itg_so = RESOLVE_STR_REF(@603402)
	OUTER_SET px_itg_se = RESOLVE_STR_REF(@603403)
	OUTER_SET px_itg_sa = RESOLVE_STR_REF(@603404)
	OUTER_SET px_itg_sm = RESOLVE_STR_REF(@603405)
	APPEND ~statdesc.2da~ ~%px_itg_f% %px_itg_sf% pxl2itgd~
	APPEND ~statdesc.2da~ ~%px_itg_o% %px_itg_so% pxl2itgd~
	APPEND ~statdesc.2da~ ~%px_itg_e% %px_itg_se% pxl2itgd~
	APPEND ~statdesc.2da~ ~%px_itg_a% %px_itg_sa% pxl2itgd~
	APPEND ~statdesc.2da~ ~%px_itg_m% %px_itg_sm% pxl2itgd~
	COPY_EXISTING ~statdesc.2da~ ~override~
	PRETTY_PRINT_2DA
	BUT_ONLY
COPY ~Derats_Magasin_2/Sorts/pxl2itgf.spl~				~override~	SAY NAME1 @603401
LPF ADD_SPELL_EFFECT	INT_VAR opcode = 142 target = 1 parameter2 = px_itg_f  duration = 30 power = 3 resist_dispel = 3 END
SET ZF_inc_level = 1	SET ZF_inc_duree = 6	LPF MULTI_LEVELS END
COPY ~Derats_Magasin_2/Sorts/pxl2itgf.spl~ ~override/pxl2itgo.spl~	SAY NAME1 @603402	WRITE_ASCII 0x76 ~pxl2itgo~ #8	WRITE_ASCII 0xae ~pxl2itgo~ #8	WRITE_BYTE 0xd2 2
LPF ADD_SPELL_EFFECT	INT_VAR opcode = 142 target = 1 parameter2 = px_itg_o  duration = 30 power = 3 resist_dispel = 3 END
LPF MULTI_LEVELS END
COPY ~Derats_Magasin_2/Sorts/pxl2itgf.spl~	~override/pxl2itge.spl~	SAY NAME1 @603403	WRITE_ASCII 0x76 ~pxl2itge~ #8	WRITE_ASCII 0xae ~pxl2itge~ #8	WRITE_BYTE 0xd2 3
LPF ADD_SPELL_EFFECT	INT_VAR opcode = 142 target = 1 parameter2 = px_itg_e  duration = 30 power = 3 resist_dispel = 3 END
LPF MULTI_LEVELS END
