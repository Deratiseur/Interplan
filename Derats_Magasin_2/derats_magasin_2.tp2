COPY ~Derats_Magasin_2/Objets/Bams~					~override~
	~Derats_Magasin_2/Objets/Copy~					~override~
	~Derats_Magasin_2/Objets/Tome/Copy~				~override~
	~Derats_Magasin_2/Objets/Sceptre/Copy~			~override~
	~Derats_Magasin_2/Objets/Discombulateur/Bams~	~override~
	~Derats_Magasin_2/Objets/Discombulateur/Copy~	~override~
	~Derats_Magasin_2/Objets/Coffre/Bams~			~override~
	~Derats_Magasin_2/Objets/Coffre/Copy~			~override~
	~Derats_Magasin_2/Objets/Coffre/Dilp/Copy~		~override~
		
//Étoile de Kahor
COPY ~Derats_Magasin_2/Objets/pxl2etoi.itm~			~override~	SAY NAME2 @801	SAY DESC @802
LAF ~GW_ADD_ITEM_TOOLTIPS~ STR_VAR GW_objet = ~pxl2etoi~ GW_tooltips = ~15527 15529~ END
ACTION_IF GAME_IS ~BGT TOB BG2EE EET~ THEN BEGIN
	COPY_EXISTING	~pxl2etoi.itm~		~override/pxl2eto2.itm~	SAY NAME2 @801999	SAY DESC @802999	WRITE_LONG 0x34 6500 WRITE_BYTE 0x60 4
	WRITE_BYTE 0x86 4	WRITE_BYTE 0x8c 4	WRITE_BYTE 0xbe 4	WRITE_BYTE 0xc4 4	WRITE_BYTE 0x1c2 8	WRITE_BYTE 0x2e2 8
	COPY ~Derats_Magasin_2/BG2/Extras/pxl2meto.itm~	~override~	SAY NAME2 @73	SAY DESC @74
	SILENT
	COPY_EXISTING	~AR0300.are~					~override~
	PATCH_IF SOURCE_SIZE > 0x28f BEGIN
	LPF ADD_AREA_ITEM	INT_VAR container_to_add_to = 13	STR_VAR item_to_add = pxl2meto	END
	END
	VERBOSE
END
//Dague porte-bonheur de Moorin
COPY ~Derats_Magasin_2/Objets/pxl2moor.itm~			~override~	SAY NAME2 @803	SAY DESC @804
//Sceptre de Convocation inconventionnelle de Nustill
//Dérivation des sorts Prêtre<->mage pour certains personnages du Sceptre
//De prêtre à mage
COPY_EXISTING	~sppr108.spl~			~override/pxl2p108.spl~ //Apaisement
				~sppr307.spl~			~override/pxl2p307.spl~ //Délivrance de la malédiction
				~sppr308.spl~			~override/pxl2p308.spl~ //Délivrance de la paralysie
				~sppr318.spl~			~override/pxl2p318.spl~ //Zone d'air pur //x1 Falgant
				~sppr403.spl~			~override/pxl2p403.spl~ //Action libre
				~sppr408.spl~			~override/pxl2p408.spl~ //Protection contre le Mal 3 m //x1 Halbus
WRITE_BYTE 0x1c 1	WRITE_ASCII 0x10 ~CAS_M02~ #8 //Abjuration
COPY_EXISTING	~sppr101.spl~			~override/pxl2p101.spl~ //Bénédiction //x1 Zandalor
				~sppr203.spl~			~override/pxl2p203.spl~ //Cantique //x1 Falgant
WRITE_BYTE 0x1c 1	WRITE_ASCII 0x10 ~CAS_M03~ #8 //Conjuration
COPY_EXISTING	~sppr208.spl~			~override/pxl2p208.spl~ //Immobilisation des personnes
				~sppr406.spl~			~override/pxl2p406.spl~ //Harmonie défensive //X1 Falgant
				~sppr505.spl~			~override/pxl2p505.spl~ //Vision véritable
WRITE_BYTE 0x1c 1	WRITE_ASCII 0x10 ~CAS_M05~ #8 //Enchantement
COPY_EXISTING	~sppr503.spl~			~override/pxl2p503.spl~ //Colonne de feu
WRITE_BYTE 0x1c 1	WRITE_ASCII 0x10 ~CAS_M06~ #8 //Invocation
COPY_EXISTING	~sppr103.spl~			~override/pxl2p103.spl~ //Soins des blessures légères
				~sppr212.spl~			~override/pxl2p212.spl~ //Ralentissement du poison
				~sppr301.spl~			~override/pxl2p301.spl~ //Animation des morts
				~sppr314.spl~			~override/pxl2p314.spl~ //Influence maléfique //x1 Arantir
				~sppr315.spl~			~override/pxl2p315.spl~ //Soins des blessures moyennes //x1 Valna
				~sppr401.spl~			~override/pxl2p401.spl~ //Soins des blessures graves //x1 Valna
				~sppr417.spl~			~override/pxl2p417.spl~ //Restitution mineure //1x Valna
				~sppr502.spl~			~override/pxl2p502.spl~ //Soins des blessures critiques //1x Valna
				~sppr514.spl~			~override/pxl2p514.spl~ //Guérison de masse
				~sppr607.spl~			~override/pxl2p607.spl~ //Guérison
				~sppr713.spl~			~override/pxl2p713.spl~ //Restauration majeure
WRITE_BYTE 0x1c 1	WRITE_ASCII 0x10 ~CAS_M07~ #8 //Nécromancie
COPY_EXISTING	~sppr105.spl~			~override/pxl2p105.spl~ //Enchevêtrement //x1 Hiravias
				~sppr113.spl~			~override/pxl2p113.spl~ //Fatalité
				~sppr202.spl~			~override/pxl2p202.spl~ //Peau d'écorce
				~sppr312.spl~			~override/pxl2p312.spl~ //Force d'un seul
WRITE_BYTE 0x1c 1	WRITE_ASCII 0x10 ~CAS_M08~ #8 //Alteration
//De mage à prêtre
COPY_EXISTING	~spwi401.spl~			~override/pxl2w401.spl~ //Confusion //x1 Imhotep
				~spwi412.spl~			~override/pxl2w412.spl~ //Grande malédiction
WRITE_BYTE 0x1c 2	WRITE_ASCII 0x10 ~CAS_P05~ #8 //Enchantement
COPY_EXISTING	~spwi502.spl~			~override/pxl2w502.spl~ //Nuage mortel //x1 Imhotep
				~spwi605.spl~			~override/pxl2w605.spl~ //Sort de mort //x1 Imhotep
WRITE_BYTE 0x1c 2	WRITE_ASCII 0x10 ~CAS_P07~ #8 //Nécromancie
COPY_EXISTING	~spwi307.spl~			~override/pxl2w307.spl~ //Invisibilité sur 3 mètres //x1 Tyrael
WRITE_BYTE 0x1c 2	WRITE_ASCII 0x10 ~CAS_P01~ #8 //Illusion
