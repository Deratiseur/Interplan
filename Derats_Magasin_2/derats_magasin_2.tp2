ACTION_IF px_interplan_scs THEN BEGIN
  COPY ~Derats_Magasin_2/Sorts/pxl2ageg.spl~ ~override~	SAY NAME1 @60633	SAY UNIDENTIFIED_DESC @60634
  READ_LONG 0x64 abilities_off
  READ_SHORT 0x68 num_abilities
  FOR (i = 0; i < num_abilities; i += 1) BEGIN
  	SAY (abilities_off + 0xc0*i + 0x1cc) @606369
  	SAY (abilities_off + 0xc0*i + 0x1fc) @6063699
  END
  COPY_EXISTING ~m_dw_sxd.lua~ ~override~
