  COPY ~Derats_Magasin_2/Sorts/pxl2dobb.spl~ ~override~	SAY NAME1 @60333	SAY UNIDENTIFIED_DESC @60334
  LPF ADD_SPELL_EFFECT	INT_VAR opcode = 142 target = 2 parameter2 = px_ambidex_i  duration = 7200 power = 3 resist_dispel = 3 END
  COPY_EXISTING ~m_dw_sxd.lua~ ~override~
