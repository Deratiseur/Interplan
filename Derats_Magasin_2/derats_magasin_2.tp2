//Dague de Kaarlac
COPY ~Derats_Magasin_2/Objets/pxl2kaar.itm~			~override~	SAY NAME2 @807	SAY DESC @808
//Catalyseur du marteau Johrünbrumd //Pas dans IWDEE parce qu'il n'y a pas les ingrédients secondaires nécessaires.
ACTION_IF GAME_IS ~BGT TOB BG2EE EET~ THEN BEGIN
	COPY ~Derats_Magasin_2/Objets/pxl2cata.itm~		~override~	SAY NAME2 @809	SAY DESC @8010
	COPY ~Derats_Magasin_2/Objets/pxl2johr.itm~		~override~	SAY NAME2 @8010996	SAY DESC @8010997
	COPY ~Derats_Magasin_2/Objets/pxl2joh2.itm~		~override~	SAY NAME2 @8010996	SAY DESC @8010998
	COPY_EXISTING	~amcall.vvc~		~override/pxl2johv.vvc~	WRITE_ASCII 0x8 ~pxl2joh1~ #8
	COPY_EXISTING	~pxl2joh2.itm~		~override/pxl2joh3.itm~	SAY NAME2 @801099999	SAY DESC @8010999
	WRITE_BYTE 0x60 6	WRITE_BYTE 0x86 6	WRITE_BYTE 0x8c 7	WRITE_BYTE 0x84 1	WRITE_SHORT 0x34 30000
	COPY ~Derats_Magasin_2/BG2/Extras/pxopoudr.itm~	~override~	SAY NAME2 @71	SAY DESC @72 //Poudre des fées
	SILENT
	COPY_EXISTING	~trmer02.sto~					~override~	ADD_STORE_ITEM ~pxopoudr~ AFTER  ~shld28~ #2 #0 #0 ~IDENTIFIED~ #1
	VERBOSE
END
