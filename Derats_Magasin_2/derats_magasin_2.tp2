DEFINE_ACTION_FUNCTION Cleric_hla
   STR_VAR Spell = ~~
BEGIN
	LAF action_add_hla STR_VAR kit_name = ~CLERIC~ ability = EVAL ~%spell%~  num_allowed = ~1~ END
	LAF action_add_hla STR_VAR kit_name = ~FIGHTER_CLERIC~ ability = EVAL ~%spell%~ num_allowed = ~1~ END
	LAF action_add_hla STR_VAR kit_name = ~CLERIC_MAGE~ ability = EVAL ~%spell%~ num_allowed = ~1~ END
	LAF action_add_hla STR_VAR kit_name = ~CLERIC_THIEF~ ability = EVAL ~%spell%~ num_allowed = ~1~ END
	LAF action_add_hla STR_VAR kit_name = ~FIGHTER_MAGE_CLERIC~ ability = EVAL ~%spell%~  num_allowed = ~1~ END
	LAF action_add_hla STR_VAR kit_name = ~CLERIC_RANGER~ ability = EVAL ~%spell%~ num_allowed = ~1~ END
	LAF action_add_hla STR_VAR kit_name = ~GODTALOS~ ability = EVAL ~%spell%~ num_allowed = ~1~ END
	LAF action_add_hla STR_VAR kit_name = ~GODHELM~ ability = EVAL ~%spell%~ num_allowed = ~1~ END
	LAF action_add_hla STR_VAR kit_name = ~GODLATHANDER~ ability = EVAL ~%spell%~ num_allowed = ~1~ END
	LAF action_add_hla STR_VAR kit_name = ~OHTYR~ ability = EVAL ~%spell%~ num_allowed = ~1~ END
	LAF action_add_hla STR_VAR kit_name = ~OHTEMPUS~ ability = EVAL ~%spell%~ num_allowed = ~1~ END
END

DEFINE_ACTION_FUNCTION Druid_hla
   STR_VAR Spell = ~~
BEGIN
	LAF action_add_hla STR_VAR kit_name = ~DRUID~ ability = EVAL ~%spell%~  num_allowed = ~1~ END
	LAF action_add_hla STR_VAR kit_name = ~FIGHTER_DRUID~ ability = EVAL ~%spell%~ num_allowed = ~1~ END
	LAF action_add_hla STR_VAR kit_name = ~TOTEMIC~ ability = EVAL ~%spell%~ num_allowed = ~1~ END
	LAF action_add_hla STR_VAR kit_name = ~SHAPESHIFTER~ ability = EVAL ~%spell%~ num_allowed = ~1~ END
	LAF action_add_hla STR_VAR kit_name = ~BEASTFRIEND~ ability = EVAL ~%spell%~  num_allowed = ~1~ END
	LAF action_add_hla STR_VAR kit_name = ~SHAMAN~ ability = EVAL ~%spell%~ num_allowed = ~1~ END
END

