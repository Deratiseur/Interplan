COPY ~Derats_Magasin_2/Sorts/Bams~			~override~
	 ~Derats_Magasin_2/Sorts/Copy~			~override~
	 ~Derats_Magasin_2/Sorts/Sounds~		~override~

SILENT
PRINT @70
INCLUDE ~Derats_Magasin_2/Scripts/Tools/Rupture.tph~
VERBOSE


// Installation des sorts de l'Interplan.
// Chaque bloc regroupe le sort, son parchemin et les correctifs propres au mode.
// Les magasins puis les ressources communes suivent la fin des deux branches.
OUTER_SET px_interplan_scs = FILE_EXISTS_IN_GAME ~m_dw_sxd.lua~

////////////////////// SORTS DE  NIVEAU 1 //////////////////////


//Explosion de feu
COPY_EXISTING	~inareans.pro~				~override/pxl2expl.pro~	WRITE_SHORT 0x204 128	WRITE_SHORT 0x206 128
ADD_PROJECTILE ~override/pxl2expl.pro~ ~pxl2_Fire_explosion~
ACTION_IF px_interplan_scs THEN BEGIN
  COPY ~Derats_Magasin_2/Sorts/pxl2ex2l.spl~				~override~	SAY NAME1 @6011	SAY UNIDENTIFIED_DESC @6012	LPF SPELL_PROJO INT_VAR projectile = ~pxl2expl~ END
  COPY_EXISTING	~pxl2ex2l.spl~ 				~override/pxl2es2.spl~	LPF SPELL_TO_INNATE END
  COPY_EXISTING ~m_dw_sxd.lua~ ~override~
  REPLACE_TEXTUALLY
      ~dwExtraMageSpells\[2\]=~
      ~dwExtraMageSpells[1].pxl2ex2l={icon='pxf2expc', groundicon='pxf2expb', name=pxl2ex2ly, desc=pxl2ex2lx, restrict_alignment={}, restrict_class={}, restrict_kit={[25]=true,}, spec=27, }
dwExtraMageSpells[2]=~
  COPY_EXISTING	~m_dw_sxd.lua~							~override~	REPLACE ~pxl2ex2ly~ @6011	REPLACE ~pxl2ex2lx~ @6012
  COPY	~Derats_Magasin_2/Objets/parcho.itm~	~override/pxl2ex2a.itm~	SAY NAME2 @6011	SAY DESC @6012	LPF cd_scroll INT_VAR unusable1 = BIT1 price = 100 STR_VAR spell = ~pxl2ex2l~ END
END ELSE BEGIN
  ADD_SPELL ~Derats_Magasin_2/Sorts/pxl2ex2l.spl~ 2 1 WIZARD_PX_FIRE_EXPLOSION	SPRINT current_spell_res "%DEST_RES%"	SAY NAME1 @6011	SAY UNIDENTIFIED_DESC @6012	LPF SPELL_PROJO INT_VAR projectile = ~pxl2expl~ END
  LAF RES_NUM_OF_SPELL_NAME
  STR_VAR spell_name = ~WIZARD_PX_FIRE_EXPLOSION~
  RET spell_res
  END
  COPY_EXISTING	~%spell_res%.spl~ 				~override/pxl2es2.spl~	LPF SPELL_TO_INNATE END
  COPY	~Derats_Magasin_2/Objets/parcho.itm~	~override/pxl2ex2a.itm~	SAY NAME2 @6011	SAY DESC @6012	LPF cd_scroll INT_VAR unusable1 = BIT1 price = 100 STR_VAR spell = EVAL ~%current_spell_res%~ END
  COPY_EXISTING	~pxl2irav.cre~							~override~
  WRITE_ASCIIE 0x31c "%current_spell_res%" #8
  WRITE_ASCIIE 0x738 "%current_spell_res%" #8
  WRITE_ASCIIE 0x744 "%current_spell_res%" #8
  WRITE_ASCIIE 0x750 "%current_spell_res%" #8
  WRITE_ASCIIE 0x75c "%current_spell_res%" #8
  WRITE_ASCIIE 0x768 "%current_spell_res%" #8
  WRITE_ASCIIE 0x774 "%current_spell_res%" #8
  COPY_EXISTING	~pxl2lant.cre~							~override~
  WRITE_ASCIIE 0x2d4 "%current_spell_res%" #8
  WRITE_ASCIIE 0x51c "%current_spell_res%" #8
  WRITE_ASCIIE 0x528 "%current_spell_res%" #8
  WRITE_ASCIIE 0x534 "%current_spell_res%" #8
  WRITE_ASCIIE 0x540 "%current_spell_res%" #8
  WRITE_ASCIIE 0x54c "%current_spell_res%" #8
  WRITE_ASCIIE 0x558 "%current_spell_res%" #8
  COPY_EXISTING	~pxl2shel.cre~							~override~
  WRITE_ASCIIE 0x2ec "%current_spell_res%" #8
  WRITE_ASCIIE 0x4d0 "%current_spell_res%" #8
  WRITE_ASCIIE 0x4dc "%current_spell_res%" #8
  COPY_EXISTING	~pxl2shib.cre~							~override~
  WRITE_ASCIIE 0x2e0 "%current_spell_res%" #8
  WRITE_ASCIIE 0x4e0 "%current_spell_res%" #8
  WRITE_ASCIIE 0x4ec "%current_spell_res%" #8
  WRITE_ASCIIE 0x4f8 "%current_spell_res%" #8
END
COPY ~Derats_Magasin_2/BG2/pxagenob.sto~				~override~	ADD_STORE_ITEM ~pxl2ex2a~ LAST #1 #0 #0 ~IDENTIFIED~ #5
COPY ~Derats_Magasin_2/BG2/Options/pxagenod.sto~		~override~	SAY 0xc @68	ADD_STORE_ITEM ~pxl2ex2a~ BEFORE ~pxl2ppyr~ #1 #0 #0 ~IDENTIFIED~ #3
COPY_EXISTING	~amcall.vvc~				~override/pxl2expv.vvc~	WRITE_ASCII 0x8 ~pxl2expl~ #8	WRITE_BYTE 0x34 28	WRITE_BYTE 0x28 10	WRITE_BYTE 0x4c 30

//Bouclier contre les sorts
ACTION_IF px_interplan_scs THEN BEGIN
  COPY ~Derats_Magasin_2/Sorts/pxl2resi.spl~				~override~	SAY NAME1 @6013	SAY UNIDENTIFIED_DESC @6014
  COPY_EXISTING ~m_dw_sxd.lua~ ~override~
  REPLACE_TEXTUALLY
      ~dwExtraMageSpells\[2\]=~
      ~dwExtraMageSpells[1].pxl2resi={icon='pxl2resc', groundicon='pxl2resb', name=pxl2resiy, desc=pxl2resix, restrict_alignment={}, restrict_class={}, restrict_kit={[29]=true,}, spec=22, }
dwExtraMageSpells[2]=~
  COPY_EXISTING	~m_dw_sxd.lua~							~override~	REPLACE ~pxl2resiy~ @6013	REPLACE ~pxl2resix~ @6014
  COPY ~Derats_Magasin_2/Objets/parcho.itm~	~override/pxl2resa.itm~	SAY NAME2 @6013	SAY DESC @6014	LPF cd_scroll INT_VAR unusable1 = BIT5 price = 100 STR_VAR spell = ~pxl2resi~ END
  COPY	~Derats_Magasin_2/Objets/Coffre/vrid/pxl2vri1.2da~	~override~
END ELSE BEGIN
  ADD_SPELL ~Derats_Magasin_2/Sorts/pxl2resi.spl~ 2 1 WIZARD_PX_ANTI_SPELLS_SHIELD	SPRINT current_spell_res "%DEST_RES%"	SAY NAME1 @6013	SAY UNIDENTIFIED_DESC @6014
  LPF ALTER_EFFECT STR_VAR match_resource= pxl2resi resource= EVAL ~%current_spell_res%~ END
  COPY ~Derats_Magasin_2/Objets/parcho.itm~	~override/pxl2resa.itm~	SAY NAME2 @6013	SAY DESC @6014	LPF cd_scroll INT_VAR unusable1 = BIT5 price = 100 STR_VAR spell = EVAL ~%current_spell_res%~ END
  COPY	~Derats_Magasin_2/Objets/Coffre/vrid/pxl2vri1.2da~	~override~	REPLACE_TEXTUALLY ~pxl2resi~ ~%current_spell_res%~
  COPY_EXISTING	~pxl2albu.cre~							~override~
  WRITE_ASCIIE 0x2d4 "%current_spell_res%" #8
  WRITE_ASCIIE 0x56c "%current_spell_res%" #8
  WRITE_ASCIIE 0x578 "%current_spell_res%" #8
  COPY_EXISTING	~pxl2ardh.cre~							~override~
  WRITE_ASCIIE 0x304 "%current_spell_res%" #8
  WRITE_ASCIIE 0x6a4 "%current_spell_res%" #8
  WRITE_ASCIIE 0x6b0 "%current_spell_res%" #8
  WRITE_ASCIIE 0x6bc "%current_spell_res%" #8
  WRITE_ASCIIE 0x6c8 "%current_spell_res%" #8
  WRITE_ASCIIE 0x6d4 "%current_spell_res%" #8
  WRITE_ASCIIE 0x6e0 "%current_spell_res%" #8
  COPY_EXISTING	~pxl2mort.cre~							~override~
  WRITE_ASCIIE 0x304 "%current_spell_res%" #8
  WRITE_ASCIIE 0x678 "%current_spell_res%" #8
  WRITE_ASCIIE 0x684 "%current_spell_res%" #8
  WRITE_ASCIIE 0x690 "%current_spell_res%" #8
  WRITE_ASCIIE 0x69c "%current_spell_res%" #8
  WRITE_ASCIIE 0x6a8 "%current_spell_res%" #8
  WRITE_ASCIIE 0x6b4 "%current_spell_res%" #8
  COPY_EXISTING	~pxl2rena.cre~							~override~
  WRITE_ASCIIE 0x304 "%current_spell_res%" #8
  WRITE_ASCIIE 0x65c "%current_spell_res%" #8
  WRITE_ASCIIE 0x668 "%current_spell_res%" #8
  WRITE_ASCIIE 0x674 "%current_spell_res%" #8
  WRITE_ASCIIE 0x680 "%current_spell_res%" #8
  WRITE_ASCIIE 0x68c "%current_spell_res%" #8
  WRITE_ASCIIE 0x698 "%current_spell_res%" #8
  COPY_EXISTING	~pxl2vrid.cre~							~override~
  WRITE_ASCIIE 0x2e0 "%current_spell_res%" #8
  WRITE_ASCIIE 0x600 "%current_spell_res%" #8
  WRITE_ASCIIE 0x60c "%current_spell_res%" #8
  WRITE_ASCIIE 0x618 "%current_spell_res%" #8
  WRITE_ASCIIE 0x624 "%current_spell_res%" #8
  WRITE_ASCIIE 0x630 "%current_spell_res%" #8
  WRITE_ASCIIE 0x63c "%current_spell_res%" #8
  COPY_EXISTING	~pxl2zago.cre~							~override~
  WRITE_ASCIIE 0x2ec "%current_spell_res%" #8
  WRITE_ASCIIE 0x584 "%current_spell_res%" #8
  WRITE_ASCIIE 0x590 "%current_spell_res%" #8
  ACTION_IF GAME_IS ~TOB BGT BG2EE EET~ THEN BEGIN
  COPY_EXISTING	~pxoagen.cre~							~override~
  WRITE_ASCIIE 0x2e0 "%current_spell_res%" #8
  WRITE_ASCIIE 0x5e8 "%current_spell_res%" #8
  END
END
COPY_EXISTING	~pxagenob.sto~							~override~	ADD_STORE_ITEM ~pxl2resa~ LAST #1 #0 #0 ~IDENTIFIED~ #5
COPY_EXISTING	~pxagenod.sto~							~override~	ADD_STORE_ITEM ~pxl2resa~ BEFORE ~pxl2ppyr~ #1 #0 #0 ~IDENTIFIED~ #3
COPY_EXISTING	~sparm2.vvc~				~override/pxl2re1v.vvc~	WRITE_ASCII 0x8 ~pxl2res1~ #8	WRITE_BYTE 0x4c 20
COPY_EXISTING	~pxl2re1v.vvc~				~override/pxl2re2v.vvc~	WRITE_ASCII 0x8 ~pxl2res2~ #8
COPY_EXISTING	~pxl2re1v.vvc~				~override/pxl2re3v.vvc~	WRITE_ASCII 0x8 ~pxl2res3~ #8

//Particules magiques de Déorie
ACTION_IF px_interplan_scs THEN BEGIN
  COPY ~Derats_Magasin_2/Sorts/pxl2part.spl~				~override~	SAY NAME1 @6015	SAY UNIDENTIFIED_DESC @6016
  COPY_EXISTING ~m_dw_sxd.lua~ ~override~
  REPLACE_TEXTUALLY
      ~dwExtraMageSpells\[2\]=~
      ~dwExtraMageSpells[1].pxl2part={icon='pxl2parc', groundicon='pxl2parb', name=pxl2party, desc=pxl2partx, restrict_alignment={}, restrict_class={}, restrict_kit={[25]=true,}, spec=27, }
dwExtraMageSpells[2]=~
  COPY_EXISTING	~m_dw_sxd.lua~							~override~	REPLACE ~pxl2party~ @6015	REPLACE ~pxl2partx~ @6016
  COPY ~Derats_Magasin_2/Objets/parcho.itm~	~override/pxl2para.itm~	SAY NAME2 @6015	SAY DESC @6016	LPF cd_scroll INT_VAR unusable1 = BIT1 price = 100 STR_VAR spell = ~pxl2part~ END
END ELSE BEGIN
  ADD_SPELL ~Derats_Magasin_2/Sorts/pxl2part.spl~ 2 1 WIZARD_PX_DEORIES_MAGICAL_PARTICLES	SPRINT current_spell_res "%DEST_RES%"	SAY NAME1 @6015	SAY UNIDENTIFIED_DESC @6016	WRITE_ASCIIE 0xae "%current_spell_res%" #8
  COPY ~Derats_Magasin_2/Objets/parcho.itm~	~override/pxl2para.itm~	SAY NAME2 @6015	SAY DESC @6016	LPF cd_scroll INT_VAR unusable1 = BIT1 price = 100 STR_VAR spell = EVAL ~%current_spell_res%~ END
END
COPY_EXISTING	~pxagenob.sto~							~override~	ADD_STORE_ITEM ~pxl2para~ LAST #1 #0 #0 ~IDENTIFIED~ #5
COPY_EXISTING	~pxagenod.sto~							~override~	ADD_STORE_ITEM ~pxl2para~ BEFORE ~pxl2ppyr~ #1 #0 #0 ~IDENTIFIED~ #3
COPY_EXISTING	~amcall.vvc~				~override/pxl2parv.vvc~	WRITE_ASCII 0x8 ~pxl2part~ #8	WRITE_BYTE 0x34 12	WRITE_LONG 0x4c ~-10~	WRITE_BYTE 0x20 (THIS | 1)

//Bouffée ardente
ACTION_IF px_interplan_scs THEN BEGIN
  COPY ~Derats_Magasin_2/Sorts/pxl2ecla.spl~				~override~	SAY NAME1 @6017	SAY UNIDENTIFIED_DESC @6018	LPF SPELL_PROJO INT_VAR projectile = ~pxl2ecla~ END
  COPY_EXISTING ~m_dw_sxd.lua~ ~override~
