  WRITE_ASCIIE 0x54c "%current_spell_res%" #8
  COPY_EXISTING	~pxl2vlad.cre~							~override~
  WRITE_ASCIIE 0x358 "%current_spell_res%" #8
  WRITE_ASCIIE 0x5b4 "%current_spell_res%" #8
  COPY_EXISTING	~pxl2vrid.cre~							~override~
  WRITE_ASCIIE 0x388 "%current_spell_res%" #8
  WRITE_ASCIIE 0x9f0 "%current_spell_res%" #8
  WRITE_ASCIIE 0x9fc "%current_spell_res%" #8
  WRITE_ASCIIE 0xa08 "%current_spell_res%" #8
  WRITE_ASCIIE 0xa14 "%current_spell_res%" #8
  WRITE_ASCIIE 0xa20 "%current_spell_res%" #8
  WRITE_ASCIIE 0xa2c "%current_spell_res%" #8
