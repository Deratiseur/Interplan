      ~dwExtraMageSpells[3].pxl2itg={icon='pxl2itgc', groundicon='pxl2itgb', name=pxl2itgy, desc=pxl2itgx, restrict_alignment={}, restrict_class={}, restrict_kit={[22]=true,}, spec=29, }
dwExtraMageSpells[4]=~
  COPY_EXISTING	~m_dw_sxd.lua~							~override~	REPLACE ~pxl2itgy~ @60339	REPLACE ~pxl2itgx~ @60340
  COPY ~Derats_Magasin_2/Objets/parcho.itm~	~override/pxl2itga.itm~	SAY NAME2 @60339	SAY DESC @60340	LPF cd_scroll INT_VAR unusable2 = BIT6 price = 300 STR_VAR spell = ~pxl2itg~ END
