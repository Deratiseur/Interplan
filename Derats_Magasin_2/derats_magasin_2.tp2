COPY_EXISTING ~statdesc.2da~ ~override~
	COUNT_2DA_ROWS 3 num_rows
	READ_2DA_ENTRY (num_rows - 1) 0 3 last_index
	SET px_armecha_i = IS_AN_INT ~last_index~ ? last_index + 1 : num_rows
	BUT_ONLY
	OUTER_SET px_armecha_s = RESOLVE_STR_REF(@60311)
	APPEND ~statdesc.2da~ ~%px_armecha_i% %px_armecha_s% pxl2armd~
	COPY_EXISTING ~statdesc.2da~ ~override~
	PRETTY_PRINT_2DA
	BUT_ONLY
