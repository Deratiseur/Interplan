COPY ~Derats_Magasin_2/Sorts/Objets/pxl2pc2.itm~		~override~	SAY NAME2 @60329
OUTER_FOR ( i=3 ; i<11 ; i +=1) BEGIN //Pour chaque objet à créer nommé de 3 à 10
	COPY_EXISTING	~pxl2pc2.itm~		~override/pxl2pc%i%.itm~	WRITE_BYTE 0xae ~i~ //Nombre de points de dégâts
