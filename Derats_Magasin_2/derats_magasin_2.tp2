  WRITE_ASCIIE 0x340 "%current_spell_res%" #8
  WRITE_ASCIIE 0x7c4 "%current_spell_res%" #8
  WRITE_ASCIIE 0x7d0 "%current_spell_res%" #8
  WRITE_ASCIIE 0x7dc "%current_spell_res%" #8
  WRITE_ASCIIE 0x7e8 "%current_spell_res%" #8
  WRITE_ASCIIE 0x7f4 "%current_spell_res%" #8
  WRITE_ASCIIE 0x800 "%current_spell_res%" #8
